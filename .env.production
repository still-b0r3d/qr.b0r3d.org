# Build settings for https://qr.b0r3d.org (loaded by `pnpm build`).
# No secrets belong here: everything in this file ends up in the public
# bundle. See .env.example for the other options.

# Served from the site root.
BASE_PATH=/

# Plain black-on-white with a quiet zone: scans everywhere.
VITE_DEFAULT_PRESET=plain
VITE_DEFAULT_DATA_TO_ENCODE=https://b0r3d.org

# There is no analytics code in this app; this stays false as a record.
VITE_ENABLE_ANALYTICS=false
