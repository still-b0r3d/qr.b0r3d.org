# Response header rules, copied to the root of dist/ by the build.
# The rest of the Content-Security-Policy is a <meta> tag in the built page
# (see vite.config.ts); a <meta> can't set frame-ancestors, so it's here.
# Permissions-Policy allows the camera for this site only (for scanning with
# it) and turns off every other device feature.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self' https://b0r3d.org https://*.b0r3d.org
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), camera=(self), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# No long cache rule for assets/ on purpose. For a few seconds after a deploy
# a request for a new file can reach a server that doesn't have it yet; with a
# "max-age=1 year, immutable" header a wrong answer then gets kept in place of
# the file (this site had a blank page that way on 2026-10-05). The site ships
# a real 404.html, so a missing file is a 404, never the page, and assets keep
# the default (max-age=0, must-revalidate, with an ETag), which heals on the
# next load. The service worker keeps its own copy for repeat visits.

# The page, the service worker and the manifest must be checked on every load
# so a new deploy is picked up. "/" is listed because that is the address
# visitors open; /index.html is served from it.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
