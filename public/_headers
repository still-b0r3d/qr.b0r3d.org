# Response header rules, copied to the root of dist/ by the build.
# The rest of the Content-Security-Policy is a <meta> tag in the built page
# (see vite.config.js); a <meta> can't set frame-ancestors, so it's here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self' https://b0r3d.org https://*.b0r3d.org
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# No long cache rule for assets/ on purpose. They used to be "max-age=1 year,
# immutable", but for a few seconds after a deploy a request for a new file can
# reach a server that doesn't have it yet, which answers with index.html (the
# single-page fallback). With that header the HTML got cached in place of the
# app's script, at the edge and in browsers, for a year: a blank page until a
# purge (2026-10-05). The default (max-age=0, must-revalidate, with an ETag)
# heals on the next load, and the service worker still serves repeat visits.

# The page, service worker and manifest must be revalidated on every load so
# a new deploy is picked up. "/" is listed because that is the URL visitors
# request; /index.html is served from it.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
